generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth v5) ───────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  passwordHash   String?
  name           String?
  nickname       String?
  gender         String?
  goalType       String?
  birthDate      DateTime?
  heightCm       Float?
  weightKg       Float?
  targetWeightKg Float?
  paceType       String?
  approachType   String?
  onboardingDone Boolean   @default(false)
  createdAt      DateTime  @default(now())

  accounts       Account[]
  sessions       Session[]
  goals          UserGoal[]
  mealLogs       MealLog[]
  bodyRecords    BodyRecord[]
  dailySummaries DailySummary[]
  userFoods      UserFood[]
}

// ─── Goals ────────────────────────────────────────────────────────────────────

model UserGoal {
  id                 String   @id @default(cuid())
  userId             String
  dailyCalorieTarget Int
  breakfastCalories  Int
  lunchCalories      Int
  dinnerCalories     Int
  snackCalories      Int
  dailyStepsTarget   Int
  estimatedBmr       Int
  targetDate         DateTime
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

// ─── Food Database ────────────────────────────────────────────────────────────

model GenericFood {
  id           String   @id @default(cuid())
  foodCode     String?  @unique
  nameJa       String
  nameEn       String?
  category     String?
  caloriesKcal Float
  proteinG     Float?
  fatG         Float?
  carbG        Float?
  fiberG       Float?
  sodiumMg     Float?
  source       String   @default("mext")
  createdAt    DateTime @default(now())

  servings  FoodServing[]
  aliases   FoodAlias[]

  @@index([nameJa])
}

model BrandedFood {
  id              String   @id @default(cuid())
  barcode         String?  @unique
  name            String
  brand           String?
  restaurantChain String?
  caloriesKcal    Float
  servingSizeG    Float?
  proteinG        Float?
  fatG            Float?
  carbG           Float?
  source          String   @default("manual")
  createdAt       DateTime @default(now())

  servings FoodServing[]
  aliases  FoodAlias[]

  @@index([name])
}

model UserFood {
  id              String   @id @default(cuid())
  userId          String
  name            String
  caloriesKcal    Float
  proteinG        Float?
  fatG            Float?
  carbG           Float?
  defaultServingG Float    @default(100)
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, name])
}

model FoodServing {
  id            String  @id @default(cuid())
  genericFoodId String?
  brandedFoodId String?
  servingName   String
  servingG      Float
  sortOrder     Int     @default(0)

  genericFood GenericFood? @relation(fields: [genericFoodId], references: [id], onDelete: Cascade)
  brandedFood BrandedFood? @relation(fields: [brandedFoodId], references: [id], onDelete: Cascade)
}

model FoodAlias {
  id            String  @id @default(cuid())
  alias         String
  genericFoodId String?
  brandedFoodId String?

  genericFood GenericFood? @relation(fields: [genericFoodId], references: [id], onDelete: Cascade)
  brandedFood BrandedFood? @relation(fields: [brandedFoodId], references: [id], onDelete: Cascade)

  @@index([alias])
}

// ─── Meal Logs ────────────────────────────────────────────────────────────────

model MealLog {
  id            String        @id @default(cuid())
  userId        String
  mealType      String
  logDate       DateTime
  totalCalories Float         @default(0)
  totalProtein  Float         @default(0)
  totalFat      Float         @default(0)
  totalCarb     Float         @default(0)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         MealLogItem[]

  @@unique([userId, mealType, logDate])
  @@index([userId, logDate])
}

model MealLogItem {
  id        String  @id @default(cuid())
  mealLogId String
  foodId    String
  foodType  String
  foodName  String
  quantityG Float
  calories  Float
  proteinG  Float?
  fatG      Float?
  carbG     Float?
  sortOrder Int     @default(0)
  mealLog   MealLog @relation(fields: [mealLogId], references: [id], onDelete: Cascade)
}

// ─── Body Records ─────────────────────────────────────────────────────────────

model BodyRecord {
  id         String   @id @default(cuid())
  userId     String
  recordDate DateTime
  weightKg   Float?
  chestCm    Float?
  waistCm    Float?
  hipCm      Float?
  upperArmCm Float?
  calfCm     Float?
  notes      String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recordDate])
  @@index([userId, recordDate])
}

// ─── Daily Summaries ──────────────────────────────────────────────────────────

model DailySummary {
  id             String   @id @default(cuid())
  userId         String
  summaryDate    DateTime
  totalCalories  Float    @default(0)
  calorieGoal    Int
  isGoalAchieved Boolean  @default(false)
  totalSteps     Int      @default(0)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, summaryDate])
  @@index([userId, summaryDate])
}
